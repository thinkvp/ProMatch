{
  "id": "com.promatch.uxpspike",
  "name": "ProMatch UXP spike",
  "version": "0.0.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "webview": {
      "allow": "yes",
      "allowLocalRendering": "yes",
      "domains": "all",
      "enableMessageBridge": "localAndRemote"
    }
  },
  "entrypoints": [
    {
      "id": "spikepanel",
      "type": "panel",
      "label": { "default": "ProMatch UXP spike" },
      "minimumSize": { "width": 320, "height": 400 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 360, "height": 600 },
      "preferredFloatingSize": { "width": 420, "height": 640 }
    }
  ]
}
